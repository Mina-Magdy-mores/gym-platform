						"description": "Returns daily operating schedule slots categorized by gender (`men` and `women`). Optional query param: `?gender=men`."
					},
					"response": []
				},
				{
					"name": "Get Gym Rules & Regulations",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json", "type": "string" }],
						"url": {
							"raw": "{{base_url}}/api/v1/gym-rules",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "gym-rules"]
						},
						"description": "Fetches active gym conduct rules, hygiene guidelines, and safety policies with category icons."
					},
					"response": []
				}
			]
		},
		{
			"name": "02. Authentication & User Profile",
			"description": "User registration, authentication, token management, and profile media management.",
			"item": [
				{
					"name": "Register New Member (Auto-Saves Token)",
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"if (pm.response.code === 201 || pm.response.code === 200) {",
								"    var jsonData = pm.response.json();",
								"    var token = jsonData.token || (jsonData.data ? jsonData.data.token : null);",
								"    if (token) { pm.collectionVariables.set('bearer_token', token); }",
								"}"
							],
							"type": "text/javascript"
						}
					}],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json", "type": "string" },
							{ "key": "Content-Type", "value": "application/json", "type": "string" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Captain Ahmed\",\n    \"email\": \"ahmed@fitclub.com\",\n    \"phone\": \"01012345678\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/register",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "register"]
						},
						"description": "Registers a new member account and automatically generates a Sanctum Bearer Token, assigning the `member` role by default."
					},
					"response": []
				},
				{
					"name": "Login (Auto-Saves Bearer Token)",
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"if (pm.response.code === 200) {",
								"    var jsonData = pm.response.json();",
								"    var token = jsonData.token || (jsonData.data ? jsonData.data.token : null);",
								"    if (token) { pm.collectionVariables.set('bearer_token', token); }",
								"}"
							],
							"type": "text/javascript"
						}
					}],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json", "type": "string" },
							{ "key": "Content-Type", "value": "application/json", "type": "string" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"mina@gym.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "login"]
						},
						"description": "Authenticates user credentials. Rate-limited to 5 requests/minute (`throttle:login`). On success, the Bearer token is automatically persisted."
					},
					"response": []
				},
				{
					"name": "Get Authenticated Profile",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json", "type": "string" }],
						"url": {
							"raw": "{{base_url}}/api/v1/profile",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "profile"]
						},
						"description": "Returns full details of the authenticated user including active roles, media avatar, certificates, and active subscription status."
					},
					"response": []
				},
				{
					"name": "Update Profile & Avatar",
					"request": {
						"method": "POST",
						"header": [{ "key": "Accept", "value": "application/json", "type": "string" }],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "name", "value": "Mina Magdy Updated", "type": "text" },
								{ "key": "email", "value": "mina@gym.com", "type": "text" },
								{ "key": "avatar", "type": "file", "src": [] }
							]
						},
						"url": {
							"raw": "{{base_url}}/api/v1/profile",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "profile"]
						},
						"description": "Updates profile details and uploads user avatar image using Spatie MediaLibrary."
					},
					"response": []
				},
				{
					"name": "Delete Media Attachment",
					"request": {
						"method": "DELETE",
						"header": [{ "key": "Accept", "value": "application/json", "type": "string" }],
						"url": {
							"raw": "{{base_url}}/api/v1/profile/media/1",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "profile", "media", "1"]
						},
						"description": "Removes a specific media item (avatar or certificate) by its Media ID."
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [{ "key": "Accept", "value": "application/json", "type": "string" }],
						"url": {
							"raw": "{{base_url}}/api/v1/logout",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "logout"]
						},
						"description": "Revokes the active Sanctum access token."
					},
					"response": []
				}
			]
		},
