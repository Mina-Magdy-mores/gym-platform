							"host": ["{{base_url}}"],
							"path": ["api", "v1", "bookings"]
						},
						"description": "Books a PT session with a coach. Applies a database **Pessimistic Lock** (`lockForUpdate`) preventing double bookings on the same slot, and decrements 1 PT session from the member's quota."
					},
					"response": []
				},
				{
					"name": "Cancel Booking & Refund Recovery",
					"request": {
						"method": "POST",
						"header": [{ "key": "Accept", "value": "application/json", "type": "string" }],
						"url": {
