					"name": "Book Private Trainer Session (Pessimistic Lock)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json", "type": "string" },
							{ "key": "Content-Type", "value": "application/json", "type": "string" }
