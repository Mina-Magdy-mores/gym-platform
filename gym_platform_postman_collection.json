						"body": {
							"mode": "raw",
							"raw": "{\n    \"trainer_id\": 2,\n    \"booking_date\": \"2026-08-25\",\n    \"start_time\": \"14:00:00\",\n    \"end_time\": \"15:00:00\",\n    \"notes\": \"Shoulder hypertrophy & core stability session.\"\n}"
