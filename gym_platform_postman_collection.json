							"path": ["api", "v1", "bookings", "1", "cancel"]
						},
						"description": "Cancels a booked session. If canceled > 24 hours prior to session start, 1 PT session is refunded to the member balance. If < 24 hours, no refund is granted to protect coach's schedule."
					},
					"response": []
				},
